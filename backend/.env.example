# Copy this file to .env and fill in your values

# Google AI Studio API key (free tier)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB storage path (on Cloud Run: bundled in the container image)
CHROMA_PERSIST_DIR=./data/chroma

# Firestore project. Locally, instead of this + real credentials, run the
# emulator (`firebase emulators:start --only firestore`) and set
# FIRESTORE_EMULATOR_HOST=localhost:8080 — no credentials needed then.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Secret used to sign JWTs — set a long random value in production
JWT_SECRET=change-me-in-production

# Seed admin account — used once by `python -m scripts.create_admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
