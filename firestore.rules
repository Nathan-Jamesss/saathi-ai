rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Backend (Cloud Run service account via Admin SDK) bypasses rules
    // entirely — these only matter if a client ever talks to Firestore
    // directly, which this app does not do. Locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
